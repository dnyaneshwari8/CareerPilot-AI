SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=careerpilot
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Use SQLite for local dev (set to True if PostgreSQL is not available)
USE_SQLITE=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_MOCK_MODE=True
